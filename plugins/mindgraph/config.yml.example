# Example of the v2 config that /mindgraph-setup writes to ~/.mempalace/config.yml.
# You normally do NOT hand-write this — the setup skill generates it. Shown for reference.

# One or more note sources. Pre-built types: markdown | obsidian | notion | apple_notes.
# ("Other" sources get a custom adapter generated by the build-adapter skill.)
sources:
  - {type: obsidian, path: ~/vault}
  # - {type: notion}          # integration token lives in ~/.mempalace/.env as NOTION_TOKEN
  # - {type: apple_notes}     # macOS only; optional: folders: [Work, Personal]

# LLM for concept extraction + wing derivation: auto | gemini | claude
# auto = Gemini if GEMINI_API_KEY set, otherwise Claude.
llm_provider: auto

# Wings/rooms are DERIVED from the concepts in your notes, not from folders.
# `ingest.py --derive-wings` proposes a nested wing -> room tree from your
# concept graph; you confirm it; `ingest.py --assign-wings` then assigns each
# note by concept overlap. Left empty until derived:
wings: []
# After derivation it looks like:
#   - name: growth
#     rooms:
#       - {name: acquisition, concepts: [activation-friction, funnel-design]}
#       - {name: retention,   concepts: [retention, churn]}

# Provisional bucket for freshly-ingested, not-yet-assigned notes.
defaults: {wing: inbox, room: general}
